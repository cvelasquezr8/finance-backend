# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="mysql://user:password@localhost:3306/finance_db"

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudflare R2 — File Storage (S3-compatible)
# Find Account ID: https://dash.cloudflare.com → R2 → Account details
R2_ACCOUNT_ID=your-cloudflare-account-id
# API tokens: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public URL: enable "Public access" on the bucket to get this
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
